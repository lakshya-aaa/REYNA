# REYNA Backend Configuration Example
# Copy this file to .env for local development. Never commit your real .env file.

# Application metadata
APP_NAME=REYNA
ENVIRONMENT=development
# Set to false in production unless private docs access is explicitly desired
ENABLE_DOCS=true
LOG_LEVEL=INFO

# Security (REQUIRED: replace with strong random secrets)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# One-time token (24+ chars) required in Authorization/X-Bootstrap-Token header to register the first account.
# Clear or unset this after initial account setup completes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REYNA_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token

# Auth rate limiting (protects /api/v1/auth/setup and /api/v1/auth/login against brute-force)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT=10
AUTH_SETUP_RATE_LIMIT=5

# PostgreSQL connection strings (Neon Free PostgreSQL or local PostgreSQL)
# Runtime (FastAPI/SQLAlchemy): use Neon's POOLED connection string (hostname contains '-pooler').
# Migrations & Backups (Alembic / pg_dump / pg_restore): use Neon's DIRECT connection string (without '-pooler').
# Render/Neon postgres:// or postgresql:// URLs are automatically normalized for SQLAlchemy.
DATABASE_URL=postgresql://neondb_owner:replace_with_password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:replace_with_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Separate database URL for automated tests (never point this at production!)
TEST_DATABASE_URL=sqlite:///./test_reyna.db

# Comma-separated list of allowed CORS origins (leave empty in private API-only deployments)
# Example: http://localhost:3000,https://your-frontend.example.com
CORS_ORIGINS=
